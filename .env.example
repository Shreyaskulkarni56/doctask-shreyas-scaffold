# Copy to .env before `make demo`.

# 'mock' runs with zero API cost and no key (used by tests and the default
# demo). Set to 'anthropic' + provide a key only when recording the video.
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=

# Only needed for Task 2 (SuperDocs API/MCP build), not for this system.
SUPERDOCS_API_KEY=
